(typetransition qcrilam_app qcrilam_app anon_inode "[userfaultfd]" qcrilam_app_userfaultfd)
(typeattribute base_typeattr_1134)
(typeattributeset base_typeattr_1134 (and (domain ) (not (crash_dump llkd runas_app simpleperf qcrilam_app ))))
(typeattribute base_typeattr_1133)
(typeattributeset base_typeattr_1133 (and (appdomain ) (not (runas_app shell simpleperf qcrilam_app ))))
(typeattribute base_typeattr_1132)
(typeattributeset base_typeattr_1132 (and (qcrilam_app ) (not (runas_app shell simpleperf ))))
(typeattribute base_typeattr_1131)
(typeattributeset base_typeattr_1131 (and (domain ) (not (qcrilam_app ))))

